---
import ElfsightWidget from './ElfsightWidget.astro';

const googleReviewsUrl = "COLE_AQUI_O_LINK_DO_GOOGLE";
---

<section id="avaliacoes" aria-labelledby="avaliacoes-titulo">
  <div class="wrap reviews-container">
    <div class="stack reviews-header">
      <p class="eyebrow">Avaliações</p>
      <h2 id="avaliacoes-titulo">Avaliações de pacientes no Google</h2>
      <p class="lede">
        Veja o que pacientes atendidos em Vitória, Serra e Vila Velha dizem sobre o atendimento do Dr. Bernardo Barroso.
      </p>
    </div>

    <ElfsightWidget
      appId="35119da1-eedd-4784-a41d-b6f155f74855"
      minHeight={{ desktop: 420, mobile: 560 }}
    />

    <a
      href={googleReviewsUrl}
      class="reviews-link"
      target="_blank"
      rel="noopener"
    >
      Ver todas as avaliações no Google
    </a>
  </div>
</section>

<style>
  #avaliacoes {
    background: #ffffff;
    border-top-color: rgba(0, 0, 0, 0.08);
  }

  .eyebrow {
    color: #5b6b73;
  }

  h2 {
    color: #0b1215;
  }

  .lede {
    color: #3d4a50;
  }

  a:focus-visible {
    outline-color: #0f766e;
  }

  .reviews-container {
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 4vw, 44px);
  }

  .reviews-header {
    gap: 12px;
    max-width: 780px;
  }

  .reviews-link {
    align-self: flex-start;
    color: #0f766e;
    font-size: 0.94rem;
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: rgba(15, 118, 110, 0.35);
  }

  .reviews-link:hover {
    color: #115e59;
    text-decoration-color: currentColor;
  }
</style>
