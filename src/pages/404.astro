---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Página não encontrada | Dr. Bernardo Barroso"
  description="A página que você acessou não existe ou foi movida."
  canonical="https://drbernardobarroso.com.br/404/"
  robots="noindex,follow"
  whatsappUrl="https://wa.me/5527992753921?text=Ol%C3%A1%2C%20gostaria%20de%20informa%C3%A7%C3%B5es%20sobre%20consulta%20com%20Dr.%20Bernardo%20Barroso%2C%20especialista%20em%20joelho."
>
  <main id="main">
    <section class="hero" style="min-height:60vh;place-items:center">
      <div class="wrap stack" style="max-width:640px;text-align:center;align-items:center;gap:20px">
        <h1>Página não encontrada</h1>
        <p class="lede" style="margin-inline:auto">O endereço que você acessou não existe ou foi movido. Veja os tratamentos do joelho na página inicial.</p>
        <a class="btn" href="/">Voltar para a página inicial</a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .hero { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,360px),1fr)); align-items:center; gap:clamp(32px,5vw,64px); border-top:0; background:radial-gradient(120% 90% at 78% 18%,#10262c 0%,#0a141b 45%,var(--bg) 100%); }
</style>
